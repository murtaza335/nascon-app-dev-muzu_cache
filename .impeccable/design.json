  "narrative": {
    "northStar": "The Matchday Workspace",
    "overview": "A quiet charcoal shell supports readable fixtures, scores, people and merchandise. Olive surfaces establish context; electric lime identifies priority actions, selection and focus. This system describes the implemented Android React Native UI previews, derived from `mobile/src/theme/tokens.ts`, `mobile/src/components/ui.tsx`, navigation and screen source.\n\nThe 21 screen previews are a visual and navigation implementation. They do not implement backend access, authentication, durable storage, offline persistence, synchronization, checkout or receipt delivery. Preview controls and unavailable messages must remain explicit about that boundary.",
    "keyCharacteristics": [
      "Solid dark surfaces with restrained lime emphasis.",
      "Android system typography and readable numeric hierarchy.",
      "Labeled controls and written status alongside color.",
      "Rounded, scrollable surfaces with native interaction feedback.",
      "Honest empty, loading, error, success and connection previews."
    ],
    "rules": [
      {
        "name": "The Named State Rule",
        "body": "State must be understandable from its label or explanation; color alone is insufficient.",
        "section": "colors"
      },
      {
        "name": "The Restrained Lime Rule",
        "body": "Reserve lime fills for priority actions and selection. Normal fixture cards retain neutral surfaces.",
        "section": "colors"
      },
      {
        "name": "The Native Type Rule",
        "body": "Preserve system font scaling and the shared type roles. Do not disable scaling to fit a composition.",
        "section": "typography"
      },
      {
        "name": "The Growing Content Rule",
        "body": "Let text and controls grow and keep task content scrollable. Verify 360x640 dp, rotation, keyboard insets and enlarged system text on Android before claiming those cases pass.",
        "section": "layout"
      },
      {
        "name": "The Solid Surface Rule",
        "body": "Use opaque tonal surfaces for readable content. Keep the translucent backdrop confined to modal dismissal space.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared source tokens and components before adding local styling.",
      "Do retain at least 48 dp action targets, written labels and system font scaling.",
      "Do keep score, timeline and featured product in the confirmed reading order.",
      "Do show missing data and unavailable integrations honestly.",
      "Do verify native layout, TalkBack, keyboard behavior, rotation and enlarged text before recording a visual pass."
    ],
    "donts": [
      "Don't use lime as the sole indication of success, connection or selection.",
      "Don't invent live data, authentication, persistence or server success in a UI preview.",
      "Don't add photography, betting, video or social features from the visual reference.",
      "Don't treat source tests, typechecking or Hermes export as native visual evidence.",
      "Don't promote an unverified accessibility assumption into a new system rule."
    ]
  }
}
