# The grader supplies DAY1_SALT through the environment. Everything else has a compose default.
# Placeholder only: never commit the real salt.
DAY1_SALT=change-me-dev-salt

# PostgreSQL credentials (compose default: app/app/app)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Redis cache-aside (see docs/CACHING.md)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_TIMEOUT_MS=200

# Test harness, running on the host
BASE_URL=http://localhost:8080
SELENIUM_URL=http://localhost:4444
APPIUM_URL=http://localhost:4723

# Browser containers reach the backend by service name
BROWSER_BASE_URL=http://backend:8080

# Set to 1 to run tests that stop/start compose services
RUN_DESTRUCTIVE=0
