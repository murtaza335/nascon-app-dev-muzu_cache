# The grader supplies DAY1_SALT through the environment. Everything else has a compose default.
# Placeholder only: never commit the real salt (export it in your shell instead).
DAY1_SALT=change-me-dev-salt

# PostgreSQL credentials (compose default: app/app/app; the DB is not published to the host)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Redis cache-aside (see docs/CACHING.md)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_TIMEOUT_MS=200

# Desk-check demo data (fixtures, rosters, products). Leave false for the grader.
SEED_DEMO_DATA=false

# Rehearse the 20-buyer checkout burst with an artificial gateway delay (ms)
MOCK_GATEWAY_LATENCY_MS=0

# Receipt archive (MinIO is not published to the host)
S3_BUCKET_RECEIPTS=receipts
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional overrides (defaults in backend/src/config.js): JWT_SECRET, JWT_TTL_SECONDS, PG_POOL_MAX, LOG_LEVEL,
# RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS (spec values 100 / 10000: do not change for grading)

# Test harness, running on the host
BASE_URL=http://localhost:8080
SELENIUM_URL=http://localhost:4444
APPIUM_URL=http://localhost:4723

# Browser containers reach the backend by service name
BROWSER_BASE_URL=http://backend:8080

# Set to 1 to run tests that stop/start compose services
RUN_DESTRUCTIVE=0
