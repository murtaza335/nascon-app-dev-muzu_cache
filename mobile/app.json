{
  "expo": {
    "name": "Sportron",
    "slug": "sportron",
    "scheme": "nascon",
    "sdkVersion": "54.0.0",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nascon.sports",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Sportron to scan match, athlete, and club QR codes." }],
      "@config-plugins/react-native-webrtc",
      "./plugins/withNasconScheme.cjs",
      "./plugins/withReceipt.cjs",
      "./plugins/withCleartext.cjs"
    ]
  }
}
