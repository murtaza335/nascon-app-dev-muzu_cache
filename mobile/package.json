{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sqlite-storage": "6.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/configure-android.mjs && expo run:android --device",
    "prebuild:android": "expo prebuild --platform android --no-install && node scripts/configure-android.mjs",
    "android:configure": "node scripts/configure-android.mjs",
    "android:device": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-device.ps1",
    "android:stop": "cd android && gradlew.bat --stop",
    "typecheck": "tsc --noEmit",
    "test:mock-data": "node --test tests/mockData.test.cjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:screens": "node --test tests/screens.test.cjs",
    "test:journeys": "node --test tests/mockJourneys.test.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "private": true
}
